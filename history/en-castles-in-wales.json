    {
      "name": "Candleston Castle",
      "principal_area": "Bridgend",
      "type": "Fortified manor house",
      "date": "14th century",
      "condition": "Ruined",
      "ownership_access": "",
      "notes": "Only the tower remains of a C14 fortified manor house built by the de Cantelupes."
    },
    {
      "name": "Coity Castle",
      "principal_area": "Bridgend",
      "type": "Keep and bailey",
      "date": "12th - 14th centuries",
      "condition": "Ruined",
      "ownership_access": "Cadw",
      "notes": "Prominently sited above Heol West Plas, Coity Castle was founded in the early twelfth century and was granted to the Norman family of Turberville."
    },
    {
      "name": "Kenfig Castle",
      "principal_area": "Bridgend",
      "type": "Keep and bailey",
      "date": "12th century",
      "condition": "Fragmentary remains",
      "ownership_access": "",
      "notes": "The scanty remains of Kenfig Castle, a once great medieval fortress, rise from the dunes beside the Cynfig river."
    },
    {
      "name": "Llangynwyd Castle",
      "principal_area": "Bridgend",
      "type": "",
      "date": "12th century",
      "condition": "Fragmentary remains",
      "ownership_access": "",
      "notes": "At Llangynwyd the remains of a once splendid medieval fortress are now reduced to scanty ruins and earthworks."
    },
    {
      "name": "Newcastle",
      "principal_area": "Bridgend",
      "type": "Enclosure castle",
      "date": "12th century",
      "condition": "Ruined",
      "ownership_access": "Cadw",
      "notes": "The castle's most outstanding feature is its complete Norman doorway, which greets the visitor approaching the castle from the south."
    },
    {
      "name": "Caerphilly Castle",
      "principal_area": "Caerphilly",
      "type": "Concentric castle",
      "date": "13th - 14th century",
      "condition": "Ruined, with partial restoration",
      "ownership_access": "Cadw",
      "notes": "Caerphilly is the largest medieval castle in Wales and one of the most impressive in Europe."
    },
    {
      "name": "Morgraig Castle",
      "principal_area": "Caerphilly",
      "type": "Enclosure castle",
      "date": "13th century",
      "condition": "Fragmentary remains",
      "ownership_access": "",
      "notes": "Built between 1243 and 1267, the form of the castle is unusual and has no comparisons elsewhere. Debate has centred on whether the castle was built by the Welsh Lords of Senghenydd, or by the Norman Lords of Glamorgan."
    },
    {
      "name": "Ruperra Castle",
      "principal_area": "Caerphilly",
      "type": "Mock castle",
      "date": "17th century",
      "condition": "Ruined",
      "ownership_access": "Private",
      "notes": "Built c1626 by Sir Thomas Morgan, steward to the Earl of Pembroke, and the latest example of the Elizabethan and Jacobean court taste for castellated mansions."
    },
    {
      "name": "Ruperra Motte",
      "principal_area": "Caerphilly",
      "type": "Motte and bailey",
      "date": "12th century",
      "condition": "Ruined, with partial restoration",
      "ownership_access": "Ruperra Conservation Trust",
      "notes": "The site includes remains of a medieval castle motte on a much earlier Iron Age hillfort."
    },
    {
      "name": "Cardiff Castle",
      "principal_area": "Cardiff",
      "type": "Shell Keep",
      "date": "11th century",
      "condition": "Ruined, with partial restoration",
      "ownership_access": "Cardiff Council",
      "notes": "Cardiff Castle was established within the walls of a mighty Roman fort by William I of England in about 1081."
    },
    {
      "name": "Castell Coch",
      "principal_area": "Cardiff",
      "type": "Gothic Revival",
      "date": "19th century (Originally 11th century)",
      "condition": "Intact",
      "ownership_access": "Cadw",
      "notes": "Castell Coch, located on a prominent wooded hillside overlooking the Taff Valley and the northern part of Cardiff, is a remarkable blend of solid medieval masonry and High Victorian Gothic fantasy."
    },
    {
      "name": "St Fagans Castle",
      "principal_area": "Cardiff",
      "type": "Enclosure castle",
      "date": "13th century",
      "condition": "Ruined",
      "ownership_access": "National Museum Wales",
      "notes": "The remains of the medieval castle at St Fagans include the southern part of a stone curtain wall. The enclosure is currently overlain by an Elizabethan mansion, with part of the surviving curtain serving to define its forecourt."
    },
    {
      "name": "Bishop's Palace, Llandaff",
      "principal_area": "Cardiff",
      "type": "Concentric castle",
      "date": "13th century",
      "condition": "Ruined",
      "ownership_access": "Cardiff Council",
      "notes": "Bishop's Palace is also known as Llandaff Castle or Bishop's Castle"
    },
    {
      "name": "Carmarthen Castle",
      "principal_area": "Carmarthenshire",
      "type": "Shell Keep",
      "date": "11th century",
      "condition": "Ruined",
      "ownership_access": "Carmarthenshire Council",
      "notes": "Remains of the high medieval castle, including a shell keep, gatehouse and two towers, are obscured by modern buildings, notably County Hall."
    },
    {
      "name": "Carreg Cennen Castle",
      "principal_area": "Carmarthenshire",
      "type": "Enclosure castle",
      "date": "13th century",
      "condition": "Ruined",
      "ownership_access": "Cadw",
      "notes": "Spectacularly set on a crag over the upper Cennen valley. A vaulted passage runs from the SE corner to a cave below E outer ward."
    },
    {
      "name": "Dinefwr Castle",
      "principal_area": "Carmarthenshire",
      "type": "",
      "date": "12th century",
      "condition": "",
      "ownership_access": "Cadw",
      "notes": "Dinefwr castle is thought to have been founded in the later twelfth century by Rhys ap Gruffudd, the Lord Rhys, and became known as the traditional capital of Dyfed."
    },
    {
      "name": "Dryslwyn Castle",
      "principal_area": "Carmarthenshire",
      "type": "",
      "date": "13th century",
      "condition": "",
      "ownership_access": "Cadw",
      "notes": "The shattered ruins of a medieval castle crown the ultimate summit of a dramatically isolated and abrupt hill rising from the Tywi floodplain."
    },
    {
      "name": "Kidwelly Castle",
      "principal_area": "Carmarthenshire",
      "type": "",
      "date": "12th century and earlier",
      "condition": "Ruined",
      "ownership_access": "Cadw",
      "notes": "Kidwelly Castle is an imposing ruin, situated on a scarp above the upper tidal limit of the Gwendraeth Fach Estuary, and considered one of the finest castles in Wales."
    },
    {
      "name": "Laugharne Castle",
      "principal_area": "Carmarthenshire",
      "type": "",
      "date": "13th century",
      "condition": "",
      "ownership_access": "Cadw",
      "notes": "The castle of Laugharne was built by the Anglo-Normans in the early twelfth century and is probably mentioned in 1116, but the existing ruins are thirteenth century and later."
    },
    {
      "name": "Llandovery Castle",
      "principal_area": "Carmarthenshire",
      "type": "",
      "date": "11th century",
      "condition": "Ruined",
      "ownership_access": "",
      "notes": "Llandovery Castle is a motte and bailey castle first mentioned in 1113. Extensive remains of masonry walls and towers occupy the motte, and a shell keep enclosure is represented by half-buried footings."
    },
    {
      "name": "Llansteffan Castle",
      "principal_area": "Carmarthenshire",
      "type": "",
      "date": "12th century",
      "condition": "",
      "ownership_access": "Cadw",
      "notes": "Prominently situated on a rocky promontory, overlooking the mouth of the Tywi. Substantial and impressive remains of a rubble masonry castle dating from the C12 to C15."
    },
    {
      "name": "Castell Moel",
      "principal_area": "Carmarthenshire",
      "type": "",
      "date": "16th century",
      "condition": "",
      "ownership_access": "",
      "notes": "Shattered ruins of a possibly 16th but probably 17th century house ruins; an early wing was incorporated into large cruciform renaissance house."
    },
    {
      "name": "Newcastle Emlyn Castle",
      "principal_area": "Carmarthenshire",
      "type": "",
      "date": "13th & 15th century",
      "condition": "",
      "ownership_access": "",
      "notes": "Shattered ruins remain of Newcastle Emlyn Castle. Excavation through the 1980s have revealed some details, but the castle is best known from a collection of medieval accounts and surveys."
    },
    {
      "name": "Aberystwyth Castle",
      "principal_area": "Ceredigion",
      "type": "Concentric castle",
      "date": "13th century",
      "condition": "Ruined",
      "ownership_access": "Aberystwyth Town Council",
      "notes": "Work on Aberystwyth Castle commenced in 1277 under Edward I and was completed in 1289. The castle remains have been much restored and now form part of a public park."
    },
    {
      "name": "Cardigan Castle",
      "principal_area": "Ceredigion",
      "type": "Motte and bailey",
      "date": "13th century",
      "condition": "",
      "ownership_access": "Ceredigion County Council",
      "notes": "Situated on promontory overlooking Cardigan Bridge. Portions of the curtain wall survive in the tall embankment overlooking the bridge. There are remains of three semi-circular towers, the largest & most elaborate incorporated into the early C19 Castle Green House"
